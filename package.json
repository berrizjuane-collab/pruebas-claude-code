{
  "name": "k2-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "K2 — Atlas interactivo: representación geográfica 3D del K2 (Karakórum) a partir de Copernicus GLO-30 y Sentinel-2, con rutas, campamentos y cámara limitada.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capturas": "node scripts/capturas.mjs",
    "perf": "node scripts/perf.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
