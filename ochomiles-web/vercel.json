{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/g2", "destination": "/gasherbrum-ii/", "permanent": false },
    { "source": "/gasherbrum-2", "destination": "/gasherbrum-ii/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|avif|png|jpg|woff2|svg|mp3|ogg|json)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
